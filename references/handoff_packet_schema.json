{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rmichaelthomas/prosecode-handoff-packet/references/handoff_packet_schema.json",
  "title": "Prosecode Handoff Packet",
  "description": "A continuity transfer object for handing off working session state between agents, models, or tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "created_for",
    "created_by",
    "date",
    "session_or_project",
    "current_goal",
    "current_state",
    "active_intent",
    "verified_sources",
    "inferred_claims",
    "locked_decisions",
    "open_questions",
    "active_user_corrections",
    "context_to_preserve",
    "work_completed",
    "work_not_yet_completed",
    "do_not_claim_beyond_this",
    "recommended_next_action",
    "handoff_notes"
  ],
  "properties": {
    "created_for": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "session_or_project": {
      "type": "string"
    },
    "current_goal": {
      "type": "string"
    },
    "current_state": {
      "type": "string"
    },
    "active_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_intent", "target_or_artifact", "status", "basis"],
      "properties": {
        "primary_intent": {
          "type": "string",
          "enum": ["explain", "create", "transform", "analyze", "decide", "plan", "fix", "unknown"]
        },
        "target_or_artifact": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "secondary_intent": {
          "type": "string"
        },
        "unresolved_slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verified_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "type", "state", "what_was_verified"],
        "properties": {
          "source": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": ["verified", "scanned", "referenced", "unavailable"]
          },
          "what_was_verified": {
            "type": "string"
          }
        }
      }
    },
    "inferred_claims": {
      "$ref": "#/$defs/basis_items"
    },
    "locked_decisions": {
      "$ref": "#/$defs/basis_items"
    },
    "open_questions": {
      "$ref": "#/$defs/question_items"
    },
    "active_user_corrections": {
      "$ref": "#/$defs/correction_items"
    },
    "context_to_preserve": {
      "$ref": "#/$defs/context_items"
    },
    "work_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "work_not_yet_completed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "do_not_claim_beyond_this": {
      "$ref": "#/$defs/boundary_items"
    },
    "recommended_next_action": {
      "type": "string"
    },
    "handoff_notes": {
      "type": "string"
    }
  },
  "$defs": {
    "basis_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "basis"],
        "properties": {
          "text": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        }
      }
    },
    "question_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "why_it_matters"],
        "properties": {
          "question": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          }
        }
      }
    },
    "correction_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["correction", "meaning_for_next_agent"],
        "properties": {
          "correction": {
            "type": "string"
          },
          "meaning_for_next_agent": {
            "type": "string"
          }
        }
      }
    },
    "context_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "why_it_matters"],
        "properties": {
          "context": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          }
        }
      }
    },
    "boundary_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary", "reason"],
        "properties": {
          "boundary": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
